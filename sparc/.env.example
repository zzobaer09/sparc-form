# SPARC 2026 - Ambassador Form & Email
# Template for the .env file. Copy to .env and fill in the real values.
# .env itself is gitignored and must NEVER be committed (PDF: "Fill .env (never commit it)").

# --- Django core ---
# Secret key for cryptographic signing (sessions, CSRF, password resets).
# Generate one:  venv/bin/python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True

# --- Site & mail identity (PDF "One-time setup" step 3) ---
# Public base URL of the site; used to build absolute links (e.g. the email logo).
SITE_URL=http://localhost:8000
# From-address for outgoing mail: display name + club Gmail in angle brackets.
MAIL_SENDER="IEEE NSU SB Portal <club@gmail.com>"

# --- Google Cloud OAuth client (PDF steps 1-2; fill after creating credentials) ---
DEV_GOOGLE_CLOUD_CLIENT_ID=
DEV_GOOGLE_CLOUD_CLIENT_SECRET=
DEV_GOOGLE_CLOUD_PROJECT_ID=
DEV_SCOPES=https://www.googleapis.com/auth/gmail.send
GOOGLE_MAIL_API_NAME=gmail
GOOGLE_MAIL_API_VERSION=v1

# --- Filled automatically by the /init/authorise/ -> /init/oauth2callback/ flow (PDF step 4) ---
GOOGLE_CLOUD_TOKEN=
GOOGLE_CLOUD_REFRESH_TOKEN=
